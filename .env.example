# Project J-EI Environment Configuration Template
# Copy this file to .env and configure your secrets.
# NEVER commit the actual .env file to version control.

# AgentRouter API Key (required for Codex Gateway single-shot inference)
agentrouter=your_agentrouter_api_key_here

# Execution Model (default: gpt-5.6-sol)
CODEX_MODEL=gpt-5.6-sol

# Optional Local SearXNG URL (default: http://localhost:8888; automatically falls back to DuckDuckGo Lite)
SEARXNG_URL=http://localhost:8888
